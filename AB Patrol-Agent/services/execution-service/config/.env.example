# Binance API 配置
# 测试网: https://testnet.binancefuture.com
# 主网: https://fapi.binance.com

# 模式: testnet | mainnet
BINANCE_MODE=testnet

# Testnet API Keys (从 https://testnet.binancefuture.com 获取)
BINANCE_TESTNET_API_KEY=your_testnet_api_key
BINANCE_TESTNET_SECRET=your_testnet_secret

# Mainnet API Keys (从币安账户获取，需要开启合约权限)
BINANCE_API_KEY=your_mainnet_api_key
BINANCE_SECRET=your_mainnet_secret

# 风控配置
MAX_DAILY_LOSS_USDT=100
MAX_POSITION_SIZE_USDT=50
MAX_LEVERAGE=5
EMERGENCY_STOP=false
