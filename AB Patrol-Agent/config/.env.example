# AB Patrol-Agent local config

# Decision route: direct provider first, fallback to OpenClaw host path if missing.
AB_PATROL_DECISION_PROVIDER=codex_cli
AB_PATROL_DECISION_FALLBACK=openclaw
AB_PATROL_DECISION_STRICT=0

# Direct provider (OpenAI-compatible)
AB_PATROL_LLM_API_BASE=
AB_PATROL_LLM_API_KEY=
AB_PATROL_LLM_MODEL=
AB_PATROL_LLM_TIMEOUT=180

# External execution infra
AB_PATROL_EXECUTION_BASE=http://127.0.0.1:8092
AB_PATROL_EXECUTION_BOT_ID=claude-pa

# Upgrade mode: keep automatic trading paused by default.
# Set to 1 only after parity/replay/binance-demo validation is complete.
AB_PATROL_ENABLE_AUTOTRADE=0

# Sidecars default to normal background mode on macOS.
# launchd can be enabled explicitly if you want OS-level supervision.
AB_PATROL_SIDECAR_USE_LAUNCHD=0

# Query service
AB_PATROL_QUERY_HOST=127.0.0.1
AB_PATROL_QUERY_PORT=8086
AB_PATROL_QUERY_BASE=http://127.0.0.1:8086

# Watchdog
AB_PATROL_WATCHDOG_CHECK_INTERVAL=300
AB_PATROL_WATCHDOG_STALE_SECONDS=900
AB_PATROL_WATCHDOG_RECOVERY_COOLDOWN=300
AB_PATROL_WATCHDOG_AUTO_RESTART_HOURS=3.0

# Aggressive Mode (激进模式)
AB_PATROL_AGGRESSIVE_MODE=1
AB_PATROL_AGGRESSIVE_MIN_PROBABILITY=0.40
AB_PATROL_AGGRESSIVE_MIN_CHECKS=3

# Rule Engine (规则引擎)
AB_PATROL_RULE_ENGINE=1

# ========== LLM 触发优化 ==========

# LLM Trigger Optimization (智能触发优化)
# 启用后：只在关键时刻触发 LLM，减少 80-90% 调用
# 1 = 启用（推荐）
# 0 = 禁用
AB_PATROL_LLM_TRIGGER_OPTIMIZATION=1

# LLM 定期分析间隔（分钟）
AB_PATROL_LLM_POSITION_INTERVAL=10  # 有持仓时，每 10 分钟深度分析
AB_PATROL_LLM_SCAN_INTERVAL=30      # 无持仓时，每 30 分钟市场分析

# Rule Engine Priority (规则引擎优先模式)
# 启用后：完全跳过 LLM，100% 使用规则引擎
# 注意：与 LLM_TRIGGER_OPTIMIZATION 互斥，优先级更高
# 1 = 规则引擎优先（完全跳过 LLM）
# 0 = 智能触发模式（推荐）
AB_PATROL_RULE_ENGINE_PRIORITY=0

# Force LLM Mode (强制 LLM 模式)
# 启用后：每次都调用 LLM（调试用）
# 注意：与 LLM_TRIGGER_OPTIMIZATION 互斥，优先级最高
# 1 = 强制 LLM（调试用）
# 0 = 正常模式
AB_PATROL_FORCE_LLM=0

# LLM Analysis Mode (LLM 分析模式)
AB_PATROL_LLM_ANALYSIS_MODE=1

# Telegram topic
AB_PATROL_TELEGRAM_CHAT_ID=-1003512657369
AB_PATROL_TELEGRAM_THREAD_ID=3
AB_PATROL_TELEGRAM_FORWARD_URL=
