# AB Patrol-Agent local config

# Decision route: direct provider first, fallback to OpenClaw host path if missing.
AB_PATROL_DECISION_PROVIDER=codex_cli
AB_PATROL_DECISION_FALLBACK=openclaw
AB_PATROL_DECISION_STRICT=0

# Direct provider (OpenAI-compatible)
AB_PATROL_LLM_API_BASE=
AB_PATROL_LLM_API_KEY=
AB_PATROL_LLM_MODEL=
AB_PATROL_LLM_TIMEOUT=180

# External execution infra
AB_PATROL_EXECUTION_BASE=http://127.0.0.1:8092
AB_PATROL_EXECUTION_BOT_ID=claude-pa

# Upgrade mode: keep automatic trading paused by default.
# Set to 1 only after parity/replay/binance-demo validation is complete.
AB_PATROL_ENABLE_AUTOTRADE=0

# Query service
AB_PATROL_QUERY_HOST=127.0.0.1
AB_PATROL_QUERY_PORT=8086
AB_PATROL_QUERY_BASE=http://127.0.0.1:8086

# Watchdog
AB_PATROL_WATCHDOG_CHECK_INTERVAL=300
AB_PATROL_WATCHDOG_STALE_SECONDS=900
AB_PATROL_WATCHDOG_RECOVERY_COOLDOWN=300

# Telegram topic
AB_PATROL_TELEGRAM_CHAT_ID=-1003512657369
AB_PATROL_TELEGRAM_THREAD_ID=3
AB_PATROL_TELEGRAM_FORWARD_URL=
