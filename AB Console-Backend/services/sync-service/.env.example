# Sync Service Configuration

# API
SYNC_API_HOST=0.0.0.0
SYNC_API_PORT=8089

# Database
SYNC_DATABASE_URL=postgresql://postgres:postgres@timescaledb:5432/market_data

# Obsidian
SYNC_OBSIDIAN_VAULT_PATH=/data/obsidian

# Sync
SYNC_BATCH_SIZE=100
SYNC_AUTO_SYNC_INTERVAL=300

# Debug
SYNC_DEBUG=false
SYNC_LOG_LEVEL=INFO
