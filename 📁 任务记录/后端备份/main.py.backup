"""
AB Console - API Gateway
Main FastAPI application
"""

import os
import logging
import asyncio
from contextlib import asynccontextmanager
from datetime import datetime
from typing import Optional, List, Dict, Any

from fastapi import FastAPI, HTTPException, Query, Depends, Header
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from pydantic import BaseModel

from .config import settings
from .obsidian_sync import obsidian_sync

# Configure logging
logging.basicConfig(
    level=getattr(logging, settings.log_level.upper()),
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
)
logger = logging.getLogger(__name__)


from .db import db
from .sqlite_db import sqlite_db
from .signal_db import signal_db

# ============================================================
# Auto Sync Task
# ============================================================
auto_sync_task = None

async def auto_sync_loop():
    """自动同步循环 - 每30秒同步一次"""
    while True:
        try:
            result = await obsidian_sync.sync_all()
            logger.info(f"Auto sync completed: {result}")
        except Exception as e:
            logger.error(f"Auto sync error: {e}")
        await asyncio.sleep(30)  # 30秒同步一次

# ============================================================
# Lifespan
# ============================================================
@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifespan handler"""
    logger.info("Starting AB Console API Gateway...")
    await db.connect()
    await sqlite_db.connect()
    await signal_db.connect()
    
    # 首次同步
    await obsidian_sync.sync_all()
    
    # 启动自动同步任务
    global auto_sync_task
    auto_sync_task = asyncio.create_task(auto_sync_loop())
    logger.info("Auto sync started (30s interval)")
    
    logger.info(f"API listening on {settings.api_host}:{settings.api_port}")
    yield
    
    logger.info("Shutting down API Gateway...")
    if auto_sync_task:
        auto_sync_task.cancel()
        try:
            await auto_sync_task
        except asyncio.CancelledError:
            pass
    await signal_db.disconnect()
    await sqlite_db.disconnect()
    await db.disconnect()

# ============================================================
# App
# ============================================================
app = FastAPI(
    title="AB Console API",
    description="Backend API for AB Console (Al Brooks Price Action trading system)",
    version="2.1.0",
    lifespan=lifespan,
)

# CORS
# Parse CORS origins from string to list
cors_origins_list = [origin.strip() for origin in settings.cors_origins.split(",")] if settings.cors_origins != "*" else ["*"]
app.add_middleware(
    CORSMiddleware,
    allow_origins=cors_origins_list,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# ============================================================
# Auth
# ============================================================
async def verify_token(x_api_token: Optional[str] = Header(None)):
    """Verify API token if configured"""
    if settings.api_token and x_api_token != settings.api_token:
        raise HTTPException(status_code=401, detail="Invalid API token")
    return x_api_token


