        "services": {
            "database": "connected" if db.pool else "disconnected",
            "indicators_db": "connected" if sqlite_db.conn else "disconnected",
            "signals_db": "connected" if signal_db.conn else "disconnected",
            "data_service": "running",
            "trading_service": "running",
            "signal_service": "running",
            "ai_service": "running",
        },
        "timestamp": datetime.utcnow().isoformat(),
    }


# ============================================================
# Routes: Market Data
# ============================================================
@app.get("/api/v1/candles/{symbol}", response_model=list[CandleData])
async def get_candles(
    symbol: str,
    interval: str = Query("1h", description="K-line interval"),
    limit: int = Query(100, ge=1, le=1000, description="Number of candles"),
    format: str = Query("standard", description="Response format: standard or obsidian"),
):
    """Get K-line/candle data for a symbol
    
    format=obsidian: Returns ISO format open_time for Obsidian plugin compatibility
    """
    logger.info(f"Getting candles for {symbol}, interval={interval}, limit={limit}, format={format}")
    
    candles = await db.fetch_candles(
        symbol=symbol,
        interval=interval,
        limit=limit
    )
    
    # Obsidian format compatibility
    if format == "obsidian":
        obsidian_candles = []
        for c in candles:
            obsidian_candles.append({
                "open_time": c["open_time"] if isinstance(c["open_time"], str) else datetime.fromtimestamp(c["time"]).isoformat(),
                "open": c["open"],
                "high": c["high"],
                "low": c["low"],
                "close": c["close"],
                "volume": c.get("volume", 0),
            })
        return obsidian_candles
    
    return candles



